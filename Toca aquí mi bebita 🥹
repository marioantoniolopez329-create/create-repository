<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Para ti, Adriana 💖</title>
<style>
  :root{
    --rosa:#ff7ab6; --rosa2:#ff9fcf; --fondo:#fff5f9; --vino:#7a0031; --verde:#1e7f55;
  }
  html,body{height:100%;margin:0}
  body{
    background: radial-gradient(1200px 600px at 50% 100%, #ffe2ee 0%, var(--fondo) 60%);
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    color: var(--vino);
    display:flex; align-items:center; justify-content:center; text-align:center;
    padding:28px; overflow:hidden;
  }
  .card{
    background:#fff; border-radius:24px; padding:28px 24px 12px;
    box-shadow:0 20px 60px rgba(0,0,0,.12), inset 0 0 0 1px #ffe3ef;
    max-width:720px; width:100%; position:relative; z-index:2;
  }
  h1{font-size:2rem; margin:.5rem 0 0; letter-spacing:.5px}
  p{font-size:1.05rem; margin:.4rem 0 .9rem}
  .big{font-size:1.15rem; font-weight:700}
  .firma{opacity:.8; font-size:.95rem; margin-top:.2rem}
  .tree-wrap{margin:6px auto 12px; max-width:520px}
  /* animaciones suaves */
  .sway{ animation:sway 5s ease-in-out infinite }
  @keyframes sway { 0%,100%{ transform:rotate(-1deg)} 50%{ transform:rotate(1.2deg)} }
  .float{ animation:float 4.5s ease-in-out infinite }
  @keyframes float { 0%,100%{ transform:translateY(0)} 50%{ transform:translateY(-6px)} }
  /* fuegos artificiales */
  canvas{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;}
</style>
</head>
<body>
<canvas id="fireworks"></canvas>
  <main class="card">
    <div class="tree-wrap">
      <svg viewBox="0 0 400 360" width="100%" aria-label="Árbol de corazones">
        <ellipse cx="200" cy="340" rx="140" ry="14" fill="#e9f6ef"/>
        <path d="M195 330c0-60-8-95-8-140 0-30 24-46 24-70 0-7-2-14-6-20l22 10c6 12 8 24 6 36-4 26-22 42-22 66 0 44 8 80 8 118z"
              fill="#8b5a2b"/>
        <rect x="186" y="210" width="28" height="130" rx="10" fill="#7a4a1f"/>
        <circle cx="140" cy="150" r="70" fill="#c8f1df"/>
        <circle cx="230" cy="120" r="80" fill="#c3efd9"/>
        <circle cx="260" cy="190" r="70" fill="#c8f1df"/>
        <circle cx="170" cy="220" r="75" fill="#c3efd9"/>
        <defs>
          <symbol id="heart" viewBox="0 0 100 90">
            <path d="M50 84S6 58 6 28C6 14 17 4 31 4c9 0 17 5 19 12 2-7 10-12 19-12 14 0 25 10 25 24 0 30-44 56-44 56Z"
                  fill="url(#grad)"/>
          </symbol>
          <linearGradient id="grad" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#ff7ab6"/>
            <stop offset="1" stop-color="#ff9fcf"/>
          </linearGradient>
        </defs>
        <g class="sway">
          <use href="#heart" x="95"  y="90"  width="26" height="26" class="float"/>
          <use href="#heart" x="135" y="65"  width="30" height="30"/>
          <use href="#heart" x="175" y="55"  width="28" height="28" class="float"/>
          <use href="#heart" x="220" y="60"  width="32" height="32"/>
          <use href="#heart" x="265" y="85"  width="26" height="26" class="float"/>
          <use href="#heart" x="110" y="140" width="32" height="32"/>
          <use href="#heart" x="155" y="130" width="26" height="26"/>
          <use href="#heart" x="200" y="120" width="34" height="34" class="float"/>
          <use href="#heart" x="245" y="135" width="28" height="28"/>
          <use href="#heart" x="290" y="150" width="30" height="30" class="float"/>
          <use href="#heart" x="120" y="195" width="28" height="28" class="float"/>
          <use href="#heart" x="165" y="200" width="26" height="26"/>
          <use href="#heart" x="210" y="195" width="30" height="30"/>
          <use href="#heart" x="255" y="205" width="26" height="26" class="float"/>
          <use href="#heart" x="200" y="240" width="28" height="28"/>
          <use href="#heart" x="150" y="245" width="26" height="26"/>
          <use href="#heart" x="260" y="245" width="26" height="26"/>
        </g>
      </svg>
    </div>

    <h1>Te amo, Adriana 💖</h1>
    <p class="big">Tengo <strong>1 año y 4 meses</strong> de estar amándote,</p>
    <p class="big">y te amaré toda mi vida, <strong>mi bebita bonita</strong> 💞</p>
    <p class="firma">— Con todo mi corazón</p>
  </main>

<script>
// Script simple de fuegos artificiales
const canvas = document.getElementById('fireworks');
const ctx = canvas.getContext('2d');
let particles = [];
function resize(){canvas.width=window.innerWidth;canvas.height=window.innerHeight}
resize();window.addEventListener('resize',resize);
function random(min,max){return Math.random()*(max-min)+min}
function createFirework(){
  const x = random(0,canvas.width), y = random(0,canvas.height/2);
  const color = `hsl(${random(0,360)},100%,60%)`;
  for(let i=0;i<50;i++){
    particles.push({x,y,angle:random(0,Math.PI*2),speed:random(1,5),life:random(30,100),color});
  }
}
function update(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  particles.forEach((p,i)=>{
    p.x += Math.cos(p.angle)*p.speed;
    p.y += Math.sin(p.angle)*p.speed;
    p.speed *= 0.98;
    p.life--;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x,p.y,2,0,Math.PI*2);
    ctx.fill();
    if(p.life<=0) particles.splice(i,1);
  });
  if(Math.random()<0.05) createFirework();
  requestAnimationFrame(update);
}
update();
</script>
</body>
</html>
